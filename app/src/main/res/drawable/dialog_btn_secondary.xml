<?xml version="1.0" encoding="utf-8"?>
<!--
  Secondary dialog button drawable.
  Shadow = @color/dialog_shadow (dark ink) against a light surface body.
  This was already correct — dark shadow on light button is clearly visible.
  No change to functionality; comments added for parity.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow: dark ink — contrasts clearly with light surface button body -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dialog_shadow" />
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Button body: surface colour (paper/cream in light, slate in dark) -->
    <item
        android:right="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface2" />
            <stroke
                android:width="2dp"
                android:color="@color/ink" />
            <corners android:radius="6dp" />
        </shape>
    </item>

</layer-list>
