<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary (outline) popup button: paper surface, 2dp ink border, 3dp offset shadow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dialog_shadow" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item android:right="3dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface2" />
            <corners android:radius="6dp" />
            <stroke android:width="2dp" android:color="@color/ink" />
        </shape>
    </item>
</layer-list>
