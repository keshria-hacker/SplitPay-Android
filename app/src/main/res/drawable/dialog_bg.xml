<?xml version="1.0" encoding="utf-8"?>
<!-- Custom popup card: paper surface, hard 2dp ink border, offset block shadow
     (peeks out 6dp on the bottom-right, like the web app's 4px 4px 0 shadow) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Offset block shadow (pen & paper style) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dialog_shadow" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <!-- Paper surface with ink border -->
    <item android:right="6dp" android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/surface" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/ink" />
        </shape>
    </item>
</layer-list>
