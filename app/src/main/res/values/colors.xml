<?xml version="1.0" encoding="utf-8"?>
<!--
  Light mode palette — Pen & Paper Ink
  ─────────────────────────────────────────────────────────────────────
  dialog_shadow_pri  NEW: green accent used as the PRIMARY button shadow
                     so it's visually distinct from the dark ink body.
                     (Fixes the bug where shadow == button == #1C2128.)
  ─────────────────────────────────────────────────────────────────────
-->
<resources>

    <!-- ── Core surfaces ────────────────────────────────────────── -->
    <color name="background">#F5F2EB</color>
    <color name="surface">#FCFAED</color>
    <color name="surface2">#EAE5D9</color>

    <!-- ── Typography & borders ─────────────────────────────────── -->
    <color name="ink">#1C2128</color>
    <color name="ink_light">#555555</color>

    <!-- ── Semantic ──────────────────────────────────────────────── -->
    <color name="ok">#205938</color>
    <color name="ok_bg">#E8F2EC</color>
    <color name="err">#8A2525</color>
    <color name="err_bg">#F4E4E4</color>

    <!-- ── Dialog button shadows ────────────────────────────────── -->
    <!-- Secondary button shadow: dark ink visible against light surface body ✓ -->
    <color name="dialog_shadow">#1C2128</color>

    <!--
      Primary button shadow (FIXED):
      Was @color/ink = #1C2128, same as the button body → invisible.
      Now dark forest green — clearly visible against the dark ink button.
      Matches the web CSS: primary buttons use `shd-pri` (green shadow).
    -->
    <color name="dialog_shadow_pri">#1A4229</color>

    <!-- ── Status bar (used by MainActivity) ────────────────────── -->
    <color name="statusBar">#F5F2EB</color>

</resources>
