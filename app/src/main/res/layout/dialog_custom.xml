<?xml version="1.0" encoding="utf-8"?>
<!--
    Reusable SplitPay popup — pen & paper style card.
    Every dialog in the app (exit confirm, no-UPI, JS alert/confirm/prompt,
    bridge popups) renders through this layout via showAppDialog().
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dialog_bg"
    android:paddingStart="20dp"
    android:paddingEnd="26dp"
    android:paddingTop="20dp"
    android:paddingBottom="28dp">

    <!-- ─── Header: icon badge + title ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/dlg_icon_badge"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/dialog_icon_badge"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:id="@+id/dlg_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                tools:src="@android:drawable/ic_menu_info_details"
                tools:tint="@color/background" />
        </LinearLayout>

        <TextView
            android:id="@+id/dlg_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.01"
            android:textColor="@color/ink"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Exit SplitPay?"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- ─── Message ─── -->
    <TextView
        android:id="@+id/dlg_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="serif"
        android:lineSpacingMultiplier="1.25"
        android:textColor="@color/ink"
        android:textSize="15sp"
        android:visibility="gone"
        tools:text="Are you sure you want to exit?"
        tools:visibility="visible" />

    <!-- ─── Optional input (used by JS prompt) ─── -->
    <EditText
        android:id="@+id/dlg_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/dialog_input_bg"
        android:fontFamily="monospace"
        android:hint="@string/dialog_input_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/ink"
        android:textColorHint="@color/ink_light"
        android:textSize="14sp"
        android:visibility="gone"
        tools:hint="Enter UPI ID"
        tools:visibility="visible" />

    <!-- ─── Buttons ─── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/dlg_negative"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/dialog_btn_secondary"
            android:fontFamily="monospace"
            android:paddingTop="12dp"
            android:paddingBottom="14dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Stay"
            tools:visibility="visible" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/dlg_positive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/dialog_btn_primary"
            android:fontFamily="monospace"
            android:paddingTop="12dp"
            android:paddingBottom="14dp"
            android:stateListAnimator="@null"
            android:textAllCaps="false"
            android:textColor="@color/background"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Exit"
            tools:visibility="visible" />
    </LinearLayout>

</LinearLayout>
