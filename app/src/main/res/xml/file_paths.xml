<?xml version="1.0" encoding="utf-8"?>
<!--
    FileProvider paths — deliberately NARROW.
    Never expose external-path "." (whole shared storage) via a grantUriPermissions
    provider. Only the app's own private dirs are exposed:
      • cache_files (cache/share/) — merchant QR poster PNGs (AndroidBridge.shareImage)
      • app_files   (files/receipts/) — reserved for a future receipt export feature
-->
<paths>
    <files-path
        name="app_files"
        path="receipts/" />
    <cache-path
        name="cache_files"
        path="share/" />
</paths>
